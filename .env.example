# このファイルはコミットする。実際の値は .env に書き、.env はコミットしない。

# --- DB ---
# ローカル (docker compose up で起動するPostgres)
LOCAL_DATABASE_URL=postgres://app:app@localhost:5432/fxgame?sslmode=disable
# 本番 (Neon)
DATABASE_URL=

# --- Discord ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=
DISCORD_REDIRECT_URI=
DISCORD_GUILD_ID=
DISCORD_TICKER_CHANNEL_ID=
DISCORD_NOTIFY_CHANNEL_ID=
# --- tick保護 ---
TICK_SHARED_SECRET=

# /claim（design.md §7.2, #39）: デプロイなしで調整できるようにする配布パラメータ
CLAIM_BASE_AMOUNT=100
CLAIM_MEDIAN_BUFF_MULTIPLIER=1.5

# 市場ティッカー（design.md §6.4・§6.11、#43 NOTIFY-1）: 毎tick編集する専用チャンネルのID
DISCORD_TICKER_CHANNEL_ID=

# 自動通知（design.md §6.7〜6.9、#44 NOTIFY-2）: #通知チャンネルのID
DISCORD_NOTIFY_CHANNEL_ID=

# 大口取引通知（design.md §6.7）: この価格インパクト%（絶対値）以上の注文を大口として通知する
LARGE_TRADE_IMPACT_PERCENT=2

# 利益確定通知（#82。design.mdに定義は無くユーザー追加要望）: この値（pips）以上の
# 利益を出した決済を通知する
PROFIT_PIPS_THRESHOLD=200
